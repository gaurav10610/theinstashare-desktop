{
  "name": "zerohop-desktop",
  "version": "2.0.0",
  "description": "ZeroHop - 100% Free & Open-Source Zero-Cloud P2P Desktop Suite: Wire-speed file transfers, 60 FPS remote desktop, encrypted calls, collaborative terminal, and local offline Whisper AI",
  "author": {
    "name": "Gaurav Kumar Yadav",
    "email": "gaurav10610@gmail.com"
  },
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "release": "node scripts/build-release.js mac",
    "release:mac": "node scripts/build-release.js mac",
    "release:win": "node scripts/build-release.js win",
    "release:linux": "node scripts/build-release.js linux",
    "release:all": "node scripts/build-release.js all",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.1",
    "@nut-tree-fork/nut-js": "^4.2.0",
    "@xenova/transformers": "^2.17.2",
    "canvas-confetti": "^1.9.4",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "lucide-react": "^0.475.0",
    "multicast-dns": "^7.2.5",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "xterm": "^5.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/multicast-dns": "^7.2.2",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "4.1.11",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "4.1.11"
  }
}
